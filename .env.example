# Optional. Never commit real passwords.
# Preview URL wins over production when set.
KUTADGU_PREVIEW_URL=
KUTADGU_BASE_URL=https://kutadgu-bilig-kitab.vercel.app

# Optional authenticated flows (SKIPPED when unset)
KUTADGU_ADMIN_EMAIL=
KUTADGU_ADMIN_PASSWORD=
KUTADGU_MEMBER_EMAIL=
KUTADGU_MEMBER_PASSWORD=

# Optional local logical dump (export only). Never commit the value.
# Dashboard → Project Settings → Database → Connect → URI (session pooler or direct).
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Destructive restore helper (scripts/restore-from-dump.sh) refuses unless BOTH are set:
# KUTADGU_RESTORE_CONFIRM=RESTORE_PRODUCTION_NOW
# KUTADGU_RESTORE_PROJECT_REF=fxlojnqwyojqjskfggmh

# --- Cloudflare preview (public). Not a production cutover. ---
# Browser-safe image host only. Leave empty until an R2 public URL exists.
# Existing Supabase cover URLs keep working either way.
KUTADGU_R2_PUBLIC_BASE_URL=

# --- Server-only. Never put these in browser JavaScript or commit real values. ---
# AI search stays off unless this is exactly true. The Vercel route is unchanged.
# The provider key stays in the host secret store or .dev.vars. It is not listed here.
AI_SEARCH_ENABLED=false

# Admin R2 upload scaffold. Disabled unless exactly true. Requires the COVERS binding.
KUTADGU_R2_UPLOAD_ENABLED=false
KUTADGU_R2_OVERWRITE=false

# --- R2 migration utility (scripts/r2-cover-inventory.js). Server/operator only. ---
# Dry-run is the default. Copy also requires KUTADGU_R2_COPY_CONFIRM=COPY_COVERS_NOW.
# There is no delete mode.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
KUTADGU_COVER_INVENTORY_FILE=
KUTADGU_R2_COPY_CONFIRM=
