    {
      "source": "/children.html",
      "destination": "/children",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/book.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "\\d+"
        }
      ],
      "destination": "/api/legacy-book-redirect"
    },
    {
      "source": "/book",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "\\d+"
        }
      ],
      "destination": "/api/legacy-book-redirect"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-index"
    },
    {
      "source": "/sitemap-books.xml",
      "destination": "/api/sitemap-books"
    },
    {
      "source": "/sitemap-books-:page(\\d+).xml",
      "destination": "/api/sitemap-books?page=:page"
    },
    {
      "source": "/adabiyat",
      "destination": "/adabiyat.html"
    },
    {
      "source": "/romanlar",
      "destination": "/romanlar.html"
    },
    {
      "source": "/tarikhiy-romanlar",
      "destination": "/tarikhiy-romanlar.html"
    },
    {
      "source": "/sheirlar",
      "destination": "/sheirlar.html"
    },
    {
      "source": "/hekayiler",
      "destination": "/hekayiler.html"
    },
    {
      "source": "/dastanlar",
      "destination": "/dastanlar.html"
    },
    {
      "source": "/dunya-edebiyati",
      "destination": "/dunya-edebiyati.html"
    },
    {
      "source": "/adabiyat-roman",
      "destination": "/adabiyat-roman.html"
    },
    {
      "source": "/uyghur-adabiyati",
      "destination": "/uyghur-adabiyati.html"
    },
    {
      "source": "/universal",
      "destination": "/universal.html"
    },
    {
      "source": "/tibb",
      "destination": "/tibb.html"
    },
    {
      "source": "/derslik",
      "destination": "/derslik.html"
    },
    {
      "source": "/terbiye",
      "destination": "/terbiye.html"
    },
    {
      "source": "/dini",
      "destination": "/dini.html"
    },
    {
      "source": "/children",
      "destination": "/children.html"
    },
    {
      "source": "/book/:id",
      "destination": "/book.html"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin-book-write.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin-book-quality.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/catalog-bibliography.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ttf|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/supabase-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/kutadgu-maintenance.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/kutadgu-announcements.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
